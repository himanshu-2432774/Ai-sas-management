# Public API base URL compiled into the frontend bundle.
# Local development uses the Vite proxy; production should use the deployed API URL.
VITE_API_BASE_URL=/api
# Example for separate production origins:
# VITE_API_BASE_URL=https://api.example.com/api

# Backend origin used only by the Vite development proxy.
VITE_BACKEND_ORIGIN=http://127.0.0.1:5001
